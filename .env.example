# ================================================================
# .env.example — Шаблон переменных окружения для Конфетница
# Скопируй этот файл в .env и заполни реальными значениями
# НЕ добавляй .env в Git!
# ================================================================

# --- База данных (Supabase / PostgreSQL) ---
# Transaction-mode pooler (для приложения)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Session-mode pooler (для миграций Prisma)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Auth / Session ---
# Минимум 32 символа. Сгенерировать: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# --- Node Environment ---
NODE_ENV="production"
