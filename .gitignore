# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# PM2 logs (generated on server)
/logs/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets
.env
.env.*
.envrc
# Allow only .env.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / OS
.idea/
.vscode/settings.json
Thumbs.db

# Dev reports (not needed in repo)
stage1_report.md
stage2_report.md
stage3_report.md
stage4_audit_report.md
walkthrough.md
